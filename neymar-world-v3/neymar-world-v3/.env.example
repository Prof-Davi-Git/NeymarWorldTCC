# Copie este arquivo como .env para configurar o servidor no seu computador.
HOST=127.0.0.1
PORT=3000

# Em produção, informe a origem HTTPS pública do site, sem caminho.
# Exemplo de formato: https://seu-site.exemplo
SITE_ORIGIN=

# Em hospedagem, use um volume persistente para guardar o banco.
SQLITE_PATH=./dados/mensagens.sqlite

# Preencha os três campos para receber uma notificação por mensagem.
# EMAIL_REMETENTE usa um endereço autorizado no Resend.
RESEND_API_KEY=
EMAIL_REMETENTE=
EMAIL_DESTINO=

# Em hospedagem com proxy reverso, ajuste ao número de proxies confiáveis
# que acrescentam seus endereços ao cabeçalho X-Forwarded-For.
PROXY_HOPS=0
